# Local demo works with none of the keys set. The IRS payment still holds
# on the offline rules. Add keys at the event for the sponsor prizes.

DATABASE_URL=sqlite+aiosqlite:///./data/lookout.db
# Set this on the Vultr host when Tiger Cloud is ready. Docker uses it instead of the local file above.
# TIGER_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/tsdb?ssl=require

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# When set, the spoken alarm AND the call-in scam checker (see apps/api/VOICE_DEMO.md)
# both speak through ElevenLabs. Left blank, the call bot falls back to Twilio's Polly voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_EN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ES=21m00Tcm4TlvDq8ikWAM

PRESAGE_API_KEY=
HOLD_TIMEOUT_SECONDS=600

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox).
# Lookout creates AUTHORIZE orders, holds them through the scam check, then
# captures or voids. PAYPAL_WEBHOOK_ID comes from the app's webhook you point at
# https://<host>/paypal/webhooks; without it every webhook is rejected.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# Shared secret between the Next proxy and the API. Empty keeps the API open
# for a local demo. Set the same value on both services in production.
LOOKOUT_API_KEY=
# ElevenLabs post-call webhook secret. Empty accepts unsigned transcripts (local demo only).
ELEVENLABS_WEBHOOK_SECRET=
# Browser origins allowed to call the API directly, comma-separated. Normally empty: the Next proxy is same-origin.
ALLOWED_ORIGINS=

# Public site. Use :80 until the GoDaddy name points at the Vultr host.
DOMAIN=:80
API_URL=http://api:8000
